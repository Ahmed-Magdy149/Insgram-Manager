@inject NavigationManager NavigationManager

<nav class="app-nav">
    <NavLink href="" class="app-nav-item" Match="NavLinkMatch.All" @onclick="HandleNavigate">
        <Icon Type="dashboard" />
        <span>Dashboard</span>
    </NavLink>

    <NavLink href="import" class="app-nav-item" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
        <Icon Type="download" />
        <span>Import</span>
    </NavLink>

    <NavLink href="communication" class="app-nav-item" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
        <Icon Type="comment" />
        <span>Communication</span>
    </NavLink>

    <NavLink href="data-explorer" class="app-nav-item" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
        <Icon Type="table" />
        <span>Data Explorer</span>
    </NavLink>

    <NavLink href="pending-requests" class="app-nav-item" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
        <Icon Type="clock-circle" />
        <span>Pending Requests</span>
    </NavLink>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="team" />
        <span>Accounts</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>

    <NavLink href="automation" class="app-nav-item" Match="NavLinkMatch.Prefix" @onclick="HandleNavigate">
        <Icon Type="thunderbolt" />
        <span>Automation</span>
    </NavLink>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="setting" />
        <span>Settings</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }
}
