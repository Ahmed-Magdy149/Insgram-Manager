@inject NavigationManager NavigationManager

<nav class="app-nav">
    <NavLink href="" class="app-nav-item" Match="NavLinkMatch.All" OnClick="HandleNavigate">
        <Icon Type="dashboard" />
        <span>Dashboard</span>
    </NavLink>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="team" />
        <span>Accounts</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="thunderbolt" />
        <span>Automation</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="bar-chart" />
        <span>Analytics</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>

    <div class="app-nav-item app-nav-item--disabled">
        <Icon Type="setting" />
        <span>Settings</span>
        <Tag Color="default" Class="app-nav-tag">Soon</Tag>
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        await OnNavigate.InvokeAsync();
    }
}
