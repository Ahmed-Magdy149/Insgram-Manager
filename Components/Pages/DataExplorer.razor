@page "/data-explorer"
@layout MainLayout
@inherits DataExplorerPageBase

<PageTitle>Data Explorer &middot; Insgram Manager</PageTitle>

<div class="data-explorer">
    <h1 class="data-explorer-title">Data Explorer</h1>
    <p class="data-explorer-subtitle">Browse, search, and export imported Instagram relationship data.</p>

    <Card Class="data-explorer-card">
        <div class="data-explorer-toolbar">
            <div class="data-explorer-search">
                <Input @bind-Value="SearchTerm"
                       Placeholder="Search by username or full name"
                       OnPressEnter="OnSearch"
                       AllowClear />
            </div>
            <div class="data-explorer-actions">
                <Button Type="@ButtonType.Primary"
                        Icon="plus"
                        OnClick="ToggleCreateSessionForm">
                    Create Session
                </Button>
                <Button Type="@ButtonType.Default"
                        Icon="login"
                        OnClick="ToggleLoginSessionForm">
                    Login Session
                </Button>
                <Button Type="@ButtonType.Default"
                        Danger="true"
                        Icon="delete"
                        AriaLabel="Cancel selected requests on Instagram"
                        Disabled="@(SelectedRows.Count == 0 || !IsInstagramSideActionSupported)"
                        Loading="IsDeletingSelectedRows"
                        AutoLoading="true"
                        OnClick="DeleteSelectedAsync" />
                <Button Type="@ButtonType.Default" Icon="download" OnClick="ExportCsvAsync">CSV Export</Button>
                <Popover Title="Columns" Trigger="@(new[] { AntDesign.Trigger.Click })" Placement="AntDesign.Placement.BottomRight">
                    <ContentTemplate>
                        <div class="data-explorer-columns">
                            <Checkbox @bind-Checked="ShowUsername">Username</Checkbox>
                            <Checkbox @bind-Checked="ShowFullName">Full Name</Checkbox>
                            <Checkbox @bind-Checked="ShowProfileUrl">Profile URL</Checkbox>
                            <Checkbox @bind-Checked="ShowType">Type</Checkbox>
                            <Checkbox @bind-Checked="ShowImportedAt">Imported At</Checkbox>
                        </div>
                    </ContentTemplate>
                    <ChildContent>
                        <Button Type="@ButtonType.Default" Icon="control">Columns</Button>
                    </ChildContent>
                </Popover>
            </div>
        </div>

        <div class="data-explorer-session-status">
            <div class="data-explorer-session-status-text">
                <span class="data-explorer-session-status-label">Session</span>
                <strong>@SelectedSessionDisplayName</strong>
            </div>

            <Tag Color="@SelectedSessionStatusColor" Class="data-explorer-session-status-tag">
                @if (IsRefreshingSessionStatus)
                {
                    <Icon Type="sync" Spin="true" />
                    <span>Verifying</span>
                }
                else
                {
                    <Icon Type="@SelectedSessionStatusIcon" />
                    <span>@SelectedSessionStatusText</span>
                }
            </Tag>
        </div>

        @if (ShowCreateSessionForm)
        {
            <Card Class="data-explorer-session-card" Title="Create Instagram Session">
                <div class="data-explorer-session-intro">
                    <strong>Log in to Instagram in the browser, then paste the cookie header here.</strong>
                    <span>You can still fill the fields manually, but the raw Cookie header will auto-parse `sessionid`, `csrftoken`, and `ds_user_id` for you.</span>
                </div>

                <div class="data-explorer-session-form">
                    <div class="data-explorer-session-actions">
                        <Button Type="@ButtonType.Primary"
                                Icon="global"
                                OnClick="OpenInstagramLoginAsync">
                            Open Instagram Login
                        </Button>
                    </div>

                    <div class="data-explorer-session-group">
                        <div class="data-explorer-session-group-title">Quick Import</div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-cookie-header">Raw Cookie Header</label>
                            <textarea id="new-session-cookie-header"
                                      class="data-explorer-session-textarea"
                                      rows="4"
                                      @bind="NewSessionCookieHeader"
                                      placeholder="Paste the Cookie header from the Instagram browser session here"></textarea>
                            <div class="data-explorer-session-help">
                                Paste the full `Cookie` header from the browser network/devtools view or a cookie-export extension.
                            </div>
                        </div>

                        <div class="data-explorer-session-actions">
                            <Button Type="@ButtonType.Default"
                                    Icon="experiment"
                                    OnClick="ParseSessionCookieHeader">
                                Parse Cookies
                            </Button>
                        </div>
                    </div>

                    <div class="data-explorer-session-group">
                        <div class="data-explorer-session-group-title">Required</div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-username">Username</label>
                            <Input id="new-session-username"
                                   @bind-Value="NewSessionUsername"
                                   Placeholder="Instagram username" />
                            <div class="data-explorer-session-help">Use the account username exactly as it appears on Instagram.</div>
                        </div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-session-id">Session ID</label>
                            <Input id="new-session-session-id"
                                   @bind-Value="NewSessionSessionId"
                                   Placeholder="sessionid value" />
                            <div class="data-explorer-session-help">Copy the value of the `sessionid` cookie from the logged-in browser.</div>
                        </div>
                    </div>

                    <div class="data-explorer-session-group">
                        <div class="data-explorer-session-group-title">Optional</div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-csrf">CSRF Token</label>
                            <Input id="new-session-csrf"
                                   @bind-Value="NewSessionCsrfToken"
                                   Placeholder="Optional CSRF token" />
                            <div class="data-explorer-session-help">Usually the `csrftoken` cookie value.</div>
                        </div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-ds-user-id">DS User ID</label>
                            <Input id="new-session-ds-user-id"
                                   @bind-Value="NewSessionDsUserId"
                                   Placeholder="Required ds_user_id value" />
                            <div class="data-explorer-session-help">Required for the live verification check against Instagram.</div>
                        </div>

                        <div class="data-explorer-session-field">
                            <label for="new-session-access-token">Access Token</label>
                            <Input id="new-session-access-token"
                                   @bind-Value="NewSessionAccessToken"
                                   Placeholder="Optional access token" />
                            <div class="data-explorer-session-help">Leave empty if you do not have a token value.</div>
                        </div>
                    </div>

                    <div class="data-explorer-session-actions">
                        <Button Type="@ButtonType.Primary"
                                Icon="save"
                                Loading="IsCreatingSession"
                                AutoLoading="true"
                                OnClick="CreateSessionAsync">
                            Save Session
                        </Button>
                        <Button Type="@ButtonType.Default"
                                Icon="close"
                                Disabled="IsCreatingSession"
                                OnClick="CancelCreateSession">
                            Cancel
                        </Button>
                    </div>
                </div>
            </Card>
        }

        @if (ShowLoginSessionForm)
        {
            <Card Class="data-explorer-session-card" Title="Sign In to Instagram">
                <div class="data-explorer-session-intro">
                    <strong>Use your Instagram username and password.</strong>
                    <span>The password is only used for sign-in and is not stored.</span>
                </div>

                <div class="data-explorer-session-form">
                    <div class="data-explorer-session-group">
                        <div class="data-explorer-session-group-title">Credentials</div>

                        <div class="data-explorer-session-field">
                            <label for="login-session-username">Username</label>
                            <Input id="login-session-username"
                                   @bind-Value="NewLoginUsername"
                                   Placeholder="Instagram username" />
                        </div>

                        <div class="data-explorer-session-field">
                            <label for="login-session-password">Password</label>
                            <input id="login-session-password"
                                   type="password"
                                   class="ant-input"
                                   @bind="NewLoginPassword"
                                   placeholder="Instagram password" />
                        </div>
                    </div>

                    <div class="data-explorer-session-actions">
                        <Button Type="@ButtonType.Primary"
                                Icon="login"
                                Loading="IsLoggingInSession"
                                AutoLoading="true"
                                OnClick="LoginSessionAsync">
                            Sign In
                        </Button>
                        <Button Type="@ButtonType.Default"
                                Icon="close"
                                Disabled="IsLoggingInSession"
                                OnClick="CancelLoginSession">
                            Cancel
                        </Button>
                    </div>
                </div>
            </Card>
        }

        @if (ShowTwoFactorLoginForm)
        {
            <Card Class="data-explorer-session-card" Title="Verify Instagram Two-Factor Code">
                <div class="data-explorer-session-intro">
                    <strong>Instagram requires a verification code for @PendingTwoFactorUsername.</strong>
                    @if (!string.IsNullOrWhiteSpace(PendingTwoFactorChallengeMessage))
                    {
                        <span class="data-explorer-session-help">@PendingTwoFactorChallengeMessage</span>
                    }
                    <span class="data-explorer-session-help">Current method: @CurrentTwoFactorMethodDisplayName.</span>
                    <span class="data-explorer-session-help">Enter the code Instagram sent by the selected method. If it does not arrive, switch to another available method below.</span>
                </div>

                <div class="data-explorer-session-form">
                    @if (PendingTwoFactorAvailableMethods.Count > 0)
                    {
                        <div class="data-explorer-session-group">
                            <div class="data-explorer-session-group-title">Verification Method</div>

                            <div class="data-explorer-session-actions">
                                @if (IsTwoFactorMethodAvailable("sms"))
                                {
                                    <Button Type="@(IsTwoFactorMethodSelected("1") ? ButtonType.Primary : ButtonType.Default)"
                                            Disabled="IsVerifyingTwoFactorCode || IsResendingTwoFactorCode"
                                            OnClick="SelectSmsVerificationMethod">
                                        SMS
                                    </Button>
                                }

                                @if (IsTwoFactorMethodAvailable("totp"))
                                {
                                    <Button Type="@(IsTwoFactorMethodSelected("3") ? ButtonType.Primary : ButtonType.Default)"
                                            Disabled="IsVerifyingTwoFactorCode || IsResendingTwoFactorCode"
                                            OnClick="SelectAuthenticatorVerificationMethod">
                                        Authenticator App
                                    </Button>
                                }

                                @if (IsTwoFactorMethodAvailable("whatsapp"))
                                {
                                    <Button Type="@(IsTwoFactorMethodSelected("1") ? ButtonType.Primary : ButtonType.Default)"
                                            Disabled="IsVerifyingTwoFactorCode || IsResendingTwoFactorCode"
                                            OnClick="SelectWhatsappVerificationMethod">
                                        WhatsApp
                                    </Button>
                                }
                            </div>
                        </div>
                    }

                    <div class="data-explorer-session-group">
                        <div class="data-explorer-session-group-title">Verification</div>

                        <div class="data-explorer-session-field">
                            <label for="two-factor-code">Verification Code</label>
                            <Input id="two-factor-code"
                                   @bind-Value="NewTwoFactorCode"
                                   Placeholder="6-digit code" />
                            <div class="data-explorer-session-help data-explorer-session-resend-hint">
                                <span>Didn't get a security code?</span>
                                <button type="button"
                                        class="data-explorer-session-resend-link"
                                        disabled="@(!CanResendTwoFactorCode)"
                                        @onclick="ResendTwoFactorCodeAsync">
                                    We can resend it.
                                </button>
                                @if (HasAlternateTwoFactorMethod)
                                {
                                    <button type="button"
                                            class="data-explorer-session-resend-link"
                                            disabled="@(IsVerifyingTwoFactorCode || IsResendingTwoFactorCode)"
                                            @onclick="UseAlternateTwoFactorMethod">
                                        Use another method.
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="data-explorer-session-actions">
                        <Button Type="@ButtonType.Primary"
                                Icon="check"
                                Loading="IsVerifyingTwoFactorCode"
                                AutoLoading="true"
                                OnClick="VerifyTwoFactorLoginAsync">
                            Verify Code
                        </Button>
                        <Button Type="@ButtonType.Default"
                                Icon="close"
                                Disabled="IsVerifyingTwoFactorCode || IsResendingTwoFactorCode"
                                OnClick="CancelTwoFactorLogin">
                            Cancel
                        </Button>
                    </div>
                </div>
            </Card>
        }

        @if (ShowInstagramChallengeNotice)
        {
            <Card Class="data-explorer-session-card" Title="Instagram Manual Verification Required">
                <div class="data-explorer-session-intro">
                    <strong>Instagram did not send an SMS code for this request.</strong>
                    @if (!string.IsNullOrWhiteSpace(InstagramChallengeMessage))
                    {
                        <span class="data-explorer-session-help">@InstagramChallengeMessage</span>
                    }
                    <span class="data-explorer-session-help">Open Instagram in the official app or web flow, confirm the login there, then return here and try again.</span>
                </div>

                <div class="data-explorer-session-actions">
                    @if (!string.IsNullOrWhiteSpace(InstagramChallengeUrl))
                    {
                        <a class="ant-btn ant-btn-primary"
                           href="@InstagramChallengeUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Open Instagram Challenge
                        </a>
                    }

                    <Button Type="@ButtonType.Default"
                            Icon="close"
                            OnClick="DismissInstagramChallengeNotice">
                        Dismiss
                    </Button>
                </div>
            </Card>
        }

        @if (!IsInstagramSideActionSupported)
        {
            <div class="data-explorer-note">
                Instagram-side cancellation is only available for <strong>Pending Requests</strong>.
            </div>
        }

        <Tabs DefaultActiveKey="@(((int)SelectedType).ToString())" OnChange="OnTypeTabChanged">
            <TabPane Key="0" Tab="Followers" />
            <TabPane Key="1" Tab="Following" />
            <TabPane Key="2" Tab="Pending Requests" />
            <TabPane Key="3" Tab="Blocked" />
            <TabPane Key="4" Tab="Recent Follow Requests" />
            <TabPane Key="5" Tab="Removed Suggestions" />
        </Tabs>

        <Table TItem="InstagramRelationship"
               DataSource="FilteredItems"
               PageSize="PageSize"
               Total="TotalCount"
               @bind-PageIndex="PageIndex"
               OnChange="OnTableChange"
               RowKey="r => r.Id"
               SelectedRows="SelectedRows"
               SelectedRowsChanged="OnSelectedRowsChanged"
               PaginationPosition="bottom"
               Loading="IsLoading"
               Class="data-explorer-table">
            <Selection Type="SelectionType.Checkbox" />
            @if (IsInstagramSideActionSupported)
            {
                <ActionColumn Title="Actions" Width="72px" Align="ColumnAlign.Center">
                    <Button Type="@ButtonType.Default"
                            Danger="true"
                            Ghost="true"
                            Icon="close-circle"
                            AriaLabel="Cancel this request on Instagram"
                            Disabled="@(string.IsNullOrWhiteSpace(SelectedAccountKey))"
                            Loading="@(DeletingRowId == context.Id)"
                            AutoLoading="true"
                            OnClick="@(() => DeleteRowAsync(context))" />
                </ActionColumn>
            }
            @if (ShowUsername)
            {
                <PropertyColumn Property="c => c.Username" Title="Username" Sortable />
            }
            @if (ShowFullName)
            {
                <PropertyColumn Property="c => c.FullName" Title="Full Name" Sortable />
            }
            @if (ShowProfileUrl)
            {
                <PropertyColumn Property="c => c.ProfileUrl" Title="Profile URL">
                    <a href="@context.ProfileUrl" target="_blank" rel="noopener noreferrer">@context.ProfileUrl</a>
                </PropertyColumn>
            }
            @if (ShowType)
            {
                <PropertyColumn Property="c => c.RelationshipType" Title="Type" Sortable>
                    <Tag Color="@GetTagColor(context.RelationshipType)">@context.RelationshipType</Tag>
                </PropertyColumn>
            }
            @if (ShowImportedAt)
            {
                <PropertyColumn Property="c => c.CreatedAt" Title="Imported At" Format="yyyy-MM-dd HH:mm" Sortable />
            }
        </Table>
    </Card>
</div>
