@page "/data-explorer"
@layout MainLayout
@inherits DataExplorerPageBase

<PageTitle>Data Explorer &middot; Insgram Manager</PageTitle>

<div class="data-explorer">
    <h1 class="data-explorer-title">Data Explorer</h1>
    <p class="data-explorer-subtitle">Browse, search, and export imported Instagram relationship data.</p>

    <Card Class="data-explorer-card">
        <div class="data-explorer-toolbar">
            <div class="data-explorer-search">
                <Input @bind-Value="SearchTerm"
                       Placeholder="Search by username or full name"
                       OnPressEnter="OnSearch"
                       AllowClear />
            </div>
            <div class="data-explorer-filter">
                <Select TItem="StatusFilterType"
                        TItemValue="StatusFilterType"
                        Value="@SelectedStatusFilter"
                        ValueChanged="@OnStatusFilterChanged"
                        Style="width: 160px;"
                        Placeholder="Filter by status">
                    <SelectOption TItem="StatusFilterType" TItemValue="StatusFilterType" Value="@StatusFilterType.All">All</SelectOption>
                    <SelectOption TItem="StatusFilterType" TItemValue="StatusFilterType" Value="@StatusFilterType.Pending">Pending</SelectOption>
                    <SelectOption TItem="StatusFilterType" TItemValue="StatusFilterType" Value="@StatusFilterType.Cancelled">Cancelled</SelectOption>
                </Select>
            </div>
            <div class="data-explorer-actions">
                <Button Type="@ButtonType.Default"
                        Danger="true"
                        Icon="delete"
                        AriaLabel="Cancel selected requests on Instagram"
                        Disabled="@(SelectedRows.Count == 0 || !IsInstagramSideActionSupported)"
                        Loading="IsDeletingSelectedRows"
                        AutoLoading="true"
                        OnClick="DeleteSelectedAsync" />
                <Button Type="@ButtonType.Default"
                        Danger="true"
                        Icon="delete"
                        AriaLabel="Cancel all pending requests on Instagram"
                        Disabled="@(!IsInstagramSideActionSupported || IsDeletingAllRows)"
                        Loading="IsDeletingAllRows"
                        AutoLoading="true"
                        OnClick="DeleteAllAsync">
                    Delete All
                </Button>
                <Button Type="@ButtonType.Default" Icon="download" OnClick="ExportCsvAsync">CSV Export</Button>
                <Popover Title="Columns" Trigger="@(new[] { AntDesign.Trigger.Click })" Placement="AntDesign.Placement.BottomRight">
                    <ContentTemplate>
                        <div class="data-explorer-columns">
                            <Checkbox @bind-Checked="ShowUsername">Username</Checkbox>
                            <Checkbox @bind-Checked="ShowFullName">Full Name</Checkbox>
                            <Checkbox @bind-Checked="ShowProfileUrl">Profile URL</Checkbox>
                            <Checkbox @bind-Checked="ShowType">Type</Checkbox>
                            <Checkbox @bind-Checked="ShowImportedAt">Imported At</Checkbox>
                        </div>
                    </ContentTemplate>
                    <ChildContent>
                        <Button Type="@ButtonType.Default" Icon="control">Columns</Button>
                    </ChildContent>
                </Popover>
            </div>
        </div>

        <div class="data-explorer-session-status">
            <div class="data-explorer-session-status-text">
                <span class="data-explorer-session-status-label">Session</span>
                <strong>@(GlobalSessionUsername ?? "Not Connected")</strong>
                @if (GlobalSessionIsConnected && GlobalSessionLastValidation is not null)
                {
                    <span class="data-explorer-session-status-sub">
                        Last validated: @GlobalSessionLastValidation.Value.ToString("yyyy-MM-dd HH:mm")
                    </span>
                }
            </div>

            <Tag Color="@(GlobalSessionIsConnected ? "green" : "red")" Class="data-explorer-session-status-tag">
                @if (IsRefreshingSessionStatus)
                {
                    <Icon Type="sync" Spin="true" />
                    <span>Verifying</span>
                }
                else
                {
                    <Icon Type="@(GlobalSessionIsConnected ? "check-circle" : "close-circle")" />
                    <span>@(GlobalSessionIsConnected ? "Connected" : "Not Connected")</span>
                }
            </Tag>
        </div>

        @if (IsDeleteInProgress)
        {
            <Card Class="data-explorer-delete-progress-card" Bordered="true">
                <div class="data-explorer-delete-progress">
                    <div class="data-explorer-delete-progress-header">
                        <div class="data-explorer-delete-progress-title">
                            <Icon Type="thunderbolt" />
                            <strong>Cancelling Pending Requests</strong>
                        </div>
                        <div class="data-explorer-delete-progress-counters">
                            <span class="data-explorer-delete-progress-remaining">@(@DeleteProgress.Total - @DeleteProgress.Processed)</span>
                            <span class="data-explorer-delete-progress-remaining-label">remaining</span>
                        </div>
                    </div>

                    <Progress Percent="@DeleteProgress.Percentage"
                              ShowInfo="true"
                              Status="@(DeleteProgress.Failed > 0 ? ProgressStatus.Exception : ProgressStatus.Active)"
                              StrokeColor="@(DeleteProgress.Failed > 0 ? "#ff4d4f" : "#1677ff")"
                              Class="data-explorer-delete-progress-bar" />

                    <div class="data-explorer-delete-progress-current">
                        <Icon Type="user" />
                        <span>Current Account:</span>
                        <strong>@DeleteProgress.CurrentUsername</strong>
                    </div>

                    <div class="data-explorer-delete-progress-stats">
                        <div class="data-explorer-delete-progress-stat data-explorer-delete-progress-stat--success">
                            <Icon Type="check-circle" />
                            <span>@DeleteProgress.Succeeded deleted</span>
                        </div>
                        @if (DeleteProgress.Skipped > 0)
                        {
                            <div class="data-explorer-delete-progress-stat data-explorer-delete-progress-stat--skipped">
                                <Icon Type="minus-circle" />
                                <span>@DeleteProgress.Skipped skipped</span>
                            </div>
                        }
                        @if (DeleteProgress.Failed > 0)
                        {
                            <div class="data-explorer-delete-progress-stat data-explorer-delete-progress-stat--failed">
                                <Icon Type="close-circle" />
                                <span>@DeleteProgress.Failed failed</span>
                            </div>
                        }
                    </div>

                    <div class="data-explorer-delete-progress-actions">
                        <Button Type="@ButtonType.Default"
                                Danger="true"
                                Icon="stop"
                                OnClick="CancelDeleteProgress">
                            Cancel
                        </Button>
                    </div>
                </div>
            </Card>
        }

        @if (!IsInstagramSideActionSupported)
        {
            <div class="data-explorer-note">
                Instagram-side cancellation is only available for <strong>Pending Requests</strong>.
            </div>
        }

        <Tabs DefaultActiveKey="@(((int)SelectedType).ToString())" OnChange="OnTypeTabChanged">
            <TabPane Key="0" Tab="Followers" />
            <TabPane Key="1" Tab="Following" />
            <TabPane Key="2" Tab="Pending Requests" />
            <TabPane Key="3" Tab="Blocked" />
            <TabPane Key="4" Tab="Recent Follow Requests" />
            <TabPane Key="5" Tab="Removed Suggestions" />
        </Tabs>

        <Table TItem="InstagramRelationship"
               DataSource="FilteredItems"
               PageSize="PageSize"
               Total="TotalCount"
               @bind-PageIndex="PageIndex"
               OnChange="OnTableChange"
               RowKey="r => r.Id"
               SelectedRows="SelectedRows"
               SelectedRowsChanged="OnSelectedRowsChanged"
               PaginationPosition="bottom"
               Loading="IsLoading"
               Class="data-explorer-table">
            <Selection Type="SelectionType.Checkbox" />
            @if (IsInstagramSideActionSupported)
            {
                <ActionColumn Title="Actions" Width="72px" Align="ColumnAlign.Center">
                    <Button Type="@ButtonType.Default"
                            Danger="true"
                            Ghost="true"
                            Icon="close-circle"
                            AriaLabel="Cancel this request on Instagram"
                            Loading="@(DeletingRowId == context.Id)"
                            AutoLoading="true"
                            OnClick="@(() => DeleteRowAsync(context))" />
                </ActionColumn>
            }
            @if (ShowUsername)
            {
                <PropertyColumn Property="c => c.Username" Title="Username" Sortable />
            }
            @if (ShowFullName)
            {
                <PropertyColumn Property="c => c.FullName" Title="Full Name" Sortable />
            }
            @if (ShowProfileUrl)
            {
                <PropertyColumn Property="c => c.ProfileUrl" Title="Profile URL">
                    <a href="@context.ProfileUrl" target="_blank" rel="noopener noreferrer">@context.ProfileUrl</a>
                </PropertyColumn>
            }
            @if (ShowType)
            {
                <PropertyColumn Property="c => c.RelationshipType" Title="Type" Sortable>
                    <Tag Color="@GetTagColor(context.RelationshipType)">@context.RelationshipType</Tag>
                </PropertyColumn>
            }
            @if (ShowImportedAt)
            {
                <PropertyColumn Property="c => c.CreatedAt" Title="Imported At" Format="yyyy-MM-dd HH:mm" Sortable />
            }
            @if (ShowFollowDate)
            {
                <PropertyColumn Property="c => c.FollowDate" Title="Follow Date" Format="yyyy-MM-dd HH:mm" Sortable />
            }
            @if (ShowStatus)
            {
                <PropertyColumn Property="c => c.IsCancelled" Title="Status">
                    @if (context.IsCancelled)
                    {
                        <Tag Color="@("red")">Cancelled</Tag>
                    }
                    else
                    {
                        <Tag Color="@("blue")">Pending</Tag>
                    }
                </PropertyColumn>
            }
        </Table>
    </Card>

    <Modal Visible="@ShowDeleteCompleteModal"
           Title="@DeleteCompleteTitle"
           OnCancel="CloseDeleteCompleteModal"
           OnOk="CloseDeleteCompleteModal"
           OkText="@("Done")"
           CancelText="@("Close")"
           Centered="true"
           Width="480">
        <div class="data-explorer-delete-complete">
            <div class="data-explorer-delete-complete-icon">
                <Icon Type="check-circle" />
            </div>
            <div class="data-explorer-delete-complete-summary">
                @DeleteCompleteSummary
            </div>
            <div class="data-explorer-delete-complete-thanks">
                Thank you, Engineer Ahmed Magdy
            </div>
        </div>
    </Modal>
</div>
