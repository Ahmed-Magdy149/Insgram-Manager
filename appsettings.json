{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=insgram.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/insgram-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Database": {
    "ConnectionString": "Data Source=insgram.db",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Import": {
    "MaxFileSizeMb": 50,
    "AllowedExtensions": [ ".json", ".csv", ".html" ],
    "BatchSize": 100,
    "SkipDuplicates": true
  },
  "Automation": {
    "MaxConcurrentWorkers": 3,
    "QueuePollingIntervalMs": 1000,
    "MaxRetries": 3,
    "RetryDelayMs": 5000,
    "Enabled": false
  },
  "Instagram": {
    "ApiBaseUrl": "https://graph.instagram.com",
    "RequestTimeoutSeconds": 30,
    "MaxRequestsPerHour": 200,
    "RateLimitBufferMs": 1000,
    "DefaultUserAgent": null
  },
  "BrowserAuth": {
    "ProfilesDirectory": "browserprofiles",
    "Headless": false,
    "LoginTimeoutSeconds": 300,
    "NavigationTimeoutSeconds": 60,
    "LoginPageUrl": "https://www.instagram.com/accounts/login/",
    "BaseUrl": "https://www.instagram.com",
    "BrowserChannel": "chrome"
  },
  "AllowedHosts": "*"
}
